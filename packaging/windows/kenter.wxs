<?xml version="1.0" encoding="utf-8"?>
<!--
  Kenter for Windows: the wallet and the desktop node, one per-machine MSI.

  Per-machine, into Program Files: a directory only an administrator can
  write to. The tray holds the node's keys and may be started at login
  from its recorded path, so whoever can replace that file would get a
  login-time process with the keys. A per-user
  install into a user-writable folder is deliberately not offered.

  Built by packaging/windows/build-msi.ps1, which passes the variables
  below. The MSI is not signed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Kenter"
           Manufacturer="Kenter"
           Version="$(Version)"
           UpgradeCode="40E32C8E-C702-44B7-914B-8AF697F818E5"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Kenter is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="KenterIcon" SourceFile="$(AssetsDir)\kenter.ico" />
    <Property Id="ARPPRODUCTICON" Value="KenterIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kenter">
        <Directory Id="SkinsDir" Name="skins">
          <Directory Id="SkinsKenterDir" Name="kenter" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="KenterMenuDir" Name="Kenter" />
    </StandardDirectory>

    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Component>
        <File Id="WalletExe" Source="$(BinDir)\kenter-ui.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Id="TrayExe" Source="$(BinDir)\kenter-node-tray.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Id="NodeCliExe" Source="$(BinDir)\kenter-node.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The wallet's skins, found beside its executable at runtime. -->
    <ComponentGroup Id="Skins" Directory="SkinsKenterDir">
      <Files Include="$(SkinsSrc)\*.svg" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="KenterMenuDir">
      <Shortcut Id="WalletShortcut" Name="Kenter Wallet"
                Target="[INSTALLFOLDER]kenter-ui.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="KenterIcon" />
      <Shortcut Id="NodeShortcut" Name="Kenter Node"
                Description="Run a Kenter pair node from the system tray"
                Target="[INSTALLFOLDER]kenter-node-tray.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="KenterIcon" />
      <RemoveFolder Id="RemoveKenterMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Kenter" Name="StartMenu"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Kenter">
      <ComponentGroupRef Id="Binaries" />
      <ComponentGroupRef Id="Skins" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
